# =============================================================================
# Gecili E-Commerce — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
# Secrets in CI come from GitHub Actions secrets, not this file.
# =============================================================================

# ---- PostgreSQL (one server, database-per-service created by init script) ----
POSTGRES_USER=gecili
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Kafka ----
KAFKA_PORT=9092

# ---- Elasticsearch ----
ELASTICSEARCH_PORT=9200

# ---- Zipkin ----
ZIPKIN_PORT=9411

# ---- Observability ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
LOKI_PORT=3100

# ---- Auth / JWT (Phase 3) ----
# RS256 signing key is provided as a file/secret, NEVER committed.
# For local dev, generate a keystore with scripts/gen-jwt-keys.(sh|ps1) — see auth-service README.
JWT_ISSUER=http://localhost:9001
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ---- Payment providers (Phase 7) — sandbox/test keys only ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Config Server ----
CONFIG_SERVER_PORT=8888

# ---- Eureka ----
EUREKA_PORT=8761

# ---- API Gateway ----
GATEWAY_PORT=8080
