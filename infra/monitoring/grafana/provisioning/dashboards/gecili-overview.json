{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "Gesili E-Commerce — Overview",
  "tags": ["gesili"],
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up, application)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Services Up",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(up{application=~\"$application\"})" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate (req/s) by service",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$application\"}[1m]))", "legendFormat": "{{application}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency (s) by service",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_seconds_bucket{application=~\"$application\"}[5m])))", "legendFormat": "{{application}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx error rate by service",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$application\", status=~\"5..\"}[1m]))", "legendFormat": "{{application}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Resilience4j circuit breaker state (productLookup)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "resilience4j_circuitbreaker_state{name=\"productLookup\"}", "legendFormat": "{{state}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap used by service",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "sum by (application) (jvm_memory_used_bytes{application=~\"$application\", area=\"heap\"})", "legendFormat": "{{application}}" }
      ]
    },
    {
      "type": "logs",
      "title": "Logs (Loki)",
      "datasource": "Loki",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "{container=~\"gesili-.*\"}" }]
    }
  ]
}
